{
  "name": "@nebari/design",
  "version": "0.1.0",
  "private": true,
  "description": "Nebari design system — a shadcn component registry.",
  "homepage": "https://github.com/nebari-dev/nebari-design",
  "type": "module",
  "packageManager": "bun@1.3.13",
  "scripts": {
    "build:registry": "shadcn build --output public/r",
    "check": "biome check",
    "check:fix": "biome check --write",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "format": "biome format",
    "format:write": "biome format --write",
    "ci": "biome ci",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:icons": "NEBARI_TEST_ICON_GALLERY=true vitest run --project=storybook",
    "storybook": "storybook dev -p 6006",
    "test:storybook": "vitest run --project=storybook",
    "build:storybook": "storybook build -o public",
    "build:pages": "bun run build:storybook && bun run build:registry"
  },
  "dependencies": {
    "@base-ui-components/react": "1.0.0-rc.0",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.17.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "@storybook/addon-a11y": "10.4.4",
    "@storybook/addon-docs": "10.4.4",
    "@storybook/addon-vitest": "10.4.4",
    "@storybook/react-vite": "^10.4.4",
    "@tailwindcss/vite": "^4.1.13",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/browser": "4.1.10",
    "@vitest/browser-playwright": "4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "jsdom": "^29.1.1",
    "playwright": "1.61.1",
    "shadcn": "^4.10.0",
    "storybook": "^10.4.4",
    "tailwindcss": "^4.1.13",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "4.1.10"
  }
}
